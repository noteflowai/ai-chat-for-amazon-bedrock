#: includes/class-ai-chat-bedrock-chat-request.php:80
#: includes/class-ai-chat-bedrock-chat-request.php:85
msgid "Message cannot be empty."
msgstr "メッセージを入力してください。"

#: includes/class-ai-chat-bedrock-chat-request.php:88
msgid "Message exceeds the 4,000 character limit."
msgstr "メッセージが 4,000 文字の上限を超えています。"

#: includes/class-ai-chat-bedrock-chat-request.php:111
msgid "Conversation history is too large."
msgstr "会話履歴が大きすぎます。"

#: includes/class-ai-chat-bedrock-chat-request.php:230
msgid "I used the available tools to gather information."
msgstr "利用可能なツールで情報を集めました。"

#. translators: 1: input tokens, 2: output tokens.
#: includes/class-ai-chat-bedrock-editor-assistant.php:248
#: public/class-ai-chat-bedrock-public.php:72
#, php-format
msgid "Tokens: %1$d in / %2$d out"
msgstr "トークン：入力 %1$d / 出力 %2$d"

#: includes/class-ai-chat-bedrock-feedback.php:61
msgid "Feedback is not collected on this site."
msgstr "このサイトではフィードバックを受け付けていません。"

#: includes/class-ai-chat-bedrock-feedback.php:66
msgid "Please sign in to send feedback."
msgstr "フィードバックを送るにはログインしてください。"

#: includes/class-ai-chat-bedrock-feedback.php:87
msgid "The rating must be up or down."
msgstr "評価は「役に立った」か「役に立たなかった」のどちらかです。"

#: includes/class-ai-chat-bedrock-feedback.php:92
msgid "That answer is no longer available for feedback."
msgstr "この回答にはもうフィードバックできません。"

#: includes/class-ai-chat-bedrock-stream.php:76
#: public/class-ai-chat-bedrock-public.php:305
msgid "Please sign in to use the chat."
msgstr "チャットを使うにはログインしてください。"

#: includes/class-ai-chat-bedrock-stream.php:79
msgid "Streaming is disabled on this site."
msgstr "このサイトではストリーミングが無効です。"

#: includes/class-ai-chat-bedrock-stream.php:87
#: public/class-ai-chat-bedrock-public.php:276
#: public/class-ai-chat-bedrock-public.php:313
msgid "Too many requests. Please wait a minute and try again."
msgstr "リクエストが多すぎます。1 分ほど待ってからもう一度お試しください。"

#: includes/class-ai-chat-bedrock-stream.php:141
msgid "Streaming is unavailable; retrying without streaming."
msgstr "ストリーミングを利用できないため、通常の方法で再試行しています。"

#: public/class-ai-chat-bedrock-public.php:42
#: public/partials/ai-chat-bedrock-public-display.php:15
msgid "Hello! How can I help you today?"
msgstr "こんにちは！今日はどのようなご用件でしょうか？"

#: public/class-ai-chat-bedrock-public.php:47
msgid "The request could not be completed. Please try again."
msgstr "リクエストを完了できませんでした。もう一度お試しください。"

#: public/class-ai-chat-bedrock-public.php:48
msgid "Answer stopped."
msgstr "回答を停止しました。"

#: public/class-ai-chat-bedrock-public.php:49
msgid "Clear this conversation?"
msgstr "この会話を消去しますか？"

#: public/class-ai-chat-bedrock-public.php:50
msgid "Copy"
msgstr "コピー"

#: public/class-ai-chat-bedrock-public.php:51
msgid "Copied"
msgstr "コピーしました"

#: public/class-ai-chat-bedrock-public.php:52
msgid "Try again"
msgstr "再試行"

#: public/class-ai-chat-bedrock-public.php:53
msgid "Was this helpful?"
msgstr "この回答は役に立ちましたか？"

#: public/class-ai-chat-bedrock-public.php:56
msgid "Thanks for the feedback."
msgstr "フィードバックありがとうございます。"

#: public/class-ai-chat-bedrock-public.php:57
msgid "Your message is too long."
msgstr "メッセージが長すぎます。"

#. translators: %d: number of tools being used.
#: public/class-ai-chat-bedrock-public.php:59
#, php-format
msgid "Using %d tool(s) to gather information…"
msgstr "%d 個のツールで情報を集めています…"

#. translators: %s: comma separated list of tool names.
#: public/class-ai-chat-bedrock-public.php:61
#, php-format
msgid "Using %s…"
msgstr "%s を使用中…"

#. translators: %d: number of tool calls the agent made.
#: public/class-ai-chat-bedrock-public.php:63
#, php-format
msgid "Agent steps (%d)"
msgstr "エージェントの手順（%d）"

#: public/class-ai-chat-bedrock-public.php:64
msgid "succeeded"
msgstr "成功"

#: public/class-ai-chat-bedrock-public.php:65
msgid "failed"
msgstr "失敗"

#. translators: %d: tool round number.
#: public/class-ai-chat-bedrock-public.php:67
#, php-format
msgid "round %d"
msgstr "%d 回目"

#: public/class-ai-chat-bedrock-public.php:68
msgid "The round limit was reached, so the answer was written with the information gathered so far."
msgstr "回数の上限に達したため、ここまでに集めた情報で回答しました。"

#. translators: %s: model identifier that answered instead of the main model.
#: public/class-ai-chat-bedrock-public.php:70
#, php-format
msgid "The main model was unavailable, so %s answered."
msgstr "メインのモデルが利用できなかったため、%s が回答しました。"

